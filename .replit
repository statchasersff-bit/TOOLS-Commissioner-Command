modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["speech-tools"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3002

[[ports]]
localPort = 5904
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[userenv]

[userenv.production]
CORS_ORIGIN = "https://statchasers.com,https://www.statchasers.com,https://dynasty-command.pages.dev"
NODE_ENV = "production"
# Enables the unified background crawler (trades + drafts) on the PUBLISHED
# deployment only. The dev workspace (npm run dev) never sees this, so it never
# double-crawls Sleeper. See server/routes.ts (ENABLE_CRAWLER gate).
ENABLE_CRAWLER = "true"

[userenv.shared]
VITE_BASE_PATH = "/dynasty-command/launch/"
VITE_API_BASE_URL = "https://dynasty-command.replit.app"
# Build-time client flag, inlined by Vite. The published build reads userenv
# vars (process.env), NOT the gitignored .env — so the league-share gate
# (isLeagueShareEnabled() in sleeperSafetyGate.ts) was always undefined in prod
# and silently blocked. Must live here to survive deploys.
VITE_ENABLE_LEAGUE_SHARE = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
