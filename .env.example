# Dynasty Command — environment variables
#
# Copy the values you need into Replit Secrets (Tools → Secrets). The
# defaults baked into `shared/appMode.ts` cover production; set these to
# override for staging, local dev, or to flip the master kill switch.

# ── App mode / domain routing ─────────────────────────────────────────────

# Comma-separated list of hosts that may expose write features. Defaults
# to "dynastycommandff.com,www.dynastycommandff.com" if unset.
WRITE_ACCESS_HOSTS=dynastycommandff.com,www.dynastycommandff.com

# Comma-separated list of read-only hosts. Defaults to
# "statchasers.com,www.statchasers.com" if unset.
READ_ONLY_HOSTS=statchasers.com,www.statchasers.com

# Master kill switch — set to "false" to force the entire stack into
# read-only regardless of host. Defaults to "true".
ENABLE_WRITE_ACCESS=true

# Canonical URLs surfaced to the UI (e.g. "Open Pro Version" links). Set
# both even though only APP_WRITE_URL is needed for write-redirect today.
APP_PUBLIC_URL=https://statchasers.com/dynasty-command
APP_WRITE_URL=https://dynastycommandff.com

# Optional hard override — use "READ_ONLY" or "WRITE_ACCESS" to force a
# specific mode for testing. Leave unset in production.
# APP_MODE=

# ── Dev / preview overrides (NON-PRODUCTION ONLY) ─────────────────────────
#
# These are READ FROM ENV ONLY when NODE_ENV !== "production" (server) or
# import.meta.env.PROD === false (browser). The runtime check is hard-coded
# in shared/appMode.ts so a production build CANNOT honor them even if the
# var is set by mistake.
#
# Use cases:
#   - Test the write flow against a Replit preview URL.
#   - Validate the locked-state modals without paying real money.
#   - Run E2E tests against a non-prod environment.

# DEV_APP_MODE — force a specific mode in dev (override domain detection).
#   "WRITE_ACCESS" makes the preview behave like dynastycommandff.com.
#   "READ_ONLY"    makes it behave like statchasers.com.
# Defaults to unset (use the real host check).
# DEV_APP_MODE=WRITE_ACCESS

# DEV_SUBSCRIPTION_OVERRIDE — when "true", treat the logged-in user as
#   subscribed regardless of their DB record. The server-side
#   requireActiveSubscription middleware bypasses the lookup, and the
#   /me payload reports active=true to the UI.
# DEV_SUBSCRIPTION_OVERRIDE=false

# DEV_SLEEPER_CONNECTED_OVERRIDE — when "true", treat the user as
#   Sleeper-connected. The requireSleeperToken middleware bypasses the
#   token lookup. NOTE: this does NOT supply a real Sleeper JWT — actual
#   write tasks that call sleeper.com/graphql will still need one.
# DEV_SLEEPER_CONNECTED_OVERRIDE=false
#
# When any of the above are active, the UI shows a yellow banner:
#   "Dev Mode: Write Access Preview Enabled"

# ── Stripe (placeholder — not required yet) ───────────────────────────────
#
# Until these are set, /api/billing/* returns a clean
# "billing_not_configured" response and the UI shows the "Coming soon"
# upgrade state. Read-only usage is never blocked by missing Stripe creds.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
